{
  "uid": "agentpilot-overview",
  "title": "AgentPilot — vue d'ensemble",
  "description": "ShopSim (trafic, erreurs, latence) et agent Support (exécutions, coût, actions, pilotage). Fichier du dépôt : monitoring/grafana/dashboards/agentpilot.json.",
  "tags": [
    "agentpilot",
    "shopsim"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Alertes",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Alertes actives",
      "description": "Alertes Prometheus déclenchées (règles de monitoring/prometheus/rules/alerts.yml), envoyées à AgentPilot par Alertmanager. Vide : tout va bien.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "severity",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "route": 2
            },
            "renameByName": {
              "alertname": "Alerte",
              "severity": "Gravité",
              "route": "Route"
            }
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Alertes en attente de leur durée",
      "description": "Condition vraie, mais pas encore depuis la durée de la règle : se déclencheront si elle dure.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"pending\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
