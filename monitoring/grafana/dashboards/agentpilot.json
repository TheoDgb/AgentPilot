          "expr": "sum by (route) (rate(http_requests_total{job=\"shopsim\",status=~\"5..\"}[1m])) / sum by (route) (rate(http_requests_total{job=\"shopsim\"}[1m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
