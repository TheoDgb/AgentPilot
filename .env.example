# Utilisateur PostgreSQL créé au premier démarrage du conteneur db
POSTGRES_USER=shopsim
# Mot de passe PostgreSQL (valeur de dev uniquement, à changer hors local)
POSTGRES_PASSWORD=shopsim
# Base principale de ShopSim
POSTGRES_DB=shopsim
# Port de l'hôte vers lequel le 5432 du conteneur est exposé (5432 est pris par un PostgreSQL local)
POSTGRES_PORT=5433
# URL utilisée depuis l'hôte (seed, app lancée hors Docker) ; dans Docker, l'app utilise db:5432
DATABASE_URL=postgresql+psycopg://shopsim:shopsim@localhost:5433/shopsim
# Base dédiée aux tests pytest (créée par docker/postgres-init/01-create-test-db.sql)
TEST_DATABASE_URL=postgresql+psycopg://shopsim:shopsim@localhost:5433/shopsim_test
# Clé d'API Anthropic pour les agents (à renseigner dans .env, jamais commitée)
ANTHROPIC_API_KEY=
# Latence simulée du service Paiements, en millisecondes (relue à chaque appel)
PAYMENT_LATENCY_MS=100
# Jeton exigé dans l'en-tête X-Chaos-Token pour activer ou arrêter les pannes (/chaos).
# Vide = Chaos désactivé. Générer une valeur avec `openssl rand -hex 16`
CHAOS_TOKEN=
