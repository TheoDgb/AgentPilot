# --- Base PostgreSQL (docker-compose.yml) ---
# Utilisateur, mot de passe et nom de la base créés par le conteneur db
POSTGRES_USER=shopsim
POSTGRES_PASSWORD=shopsim
POSTGRES_DB=shopsim
# Port de PostgreSQL sur l'hôte (5432 est pris par un PostgreSQL local)
POSTGRES_PORT=5433

# --- ShopSim ---
# Connexion de ShopSim à la base ; dans Docker, compose la remplace par db:5432
DATABASE_URL=postgresql+psycopg://shopsim:shopsim@localhost:5433/shopsim
# Latence simulée du service Paiements, en ms (relue à chaque appel ; 0 dans les tests)
PAYMENT_LATENCY_MS=100
# Jeton des pannes Chaos (en-tête X-Chaos-Token) ; vide = Chaos fermé. Jamais donné aux agents
CHAOS_TOKEN=
# 1 (valeur exacte) fige l'horloge au 2026-07-06 12:00 UTC : à utiliser pour les évaluations
SHOPSIM_FREEZE_CLOCK=0

# --- Serveur MCP ---
# Adresse de ShopSim appelée par le serveur MCP (et par AgentPilot pour lire GET /clock)
SHOPSIM_URL=http://localhost:8000
# Délai maximal d'un appel à ShopSim, en secondes
SHOPSIM_TIMEOUT_S=10
# 1 (valeur exacte) ajoute les outils d'action ; jamais pour l'agent Ops ni dans .mcp.json
SHOPSIM_MCP_ACTIONS=0

# --- AgentPilot ---
# Clé de l'API Anthropic (agent Support, CLI et service). Secret : uniquement dans .env
ANTHROPIC_API_KEY=
# Base où AgentPilot enregistre ses exécutions (schéma agentpilot)
AGENTPILOT_DATABASE_URL=postgresql+psycopg://shopsim:shopsim@localhost:5433/shopsim

# --- Tests ---
# Base des tests (shopsim/ et agentpilot/), recréée à chaque session de tests
TEST_DATABASE_URL=postgresql+psycopg://shopsim:shopsim@localhost:5433/shopsim_test
